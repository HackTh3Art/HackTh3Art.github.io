{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hacktheart-newsletter",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://hacktheart.ro",
    "POSTA_LIST_NAME": "HackTheArt Newsletter"
  },
  "secrets": {
    "required": ["POSTA_BASE_URL", "POSTA_API_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
